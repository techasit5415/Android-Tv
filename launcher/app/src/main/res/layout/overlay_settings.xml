<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/settingsOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#D9000000"
    android:clickable="true"
    android:focusable="false"
    android:descendantFocusability="afterDescendants"
    android:visibility="gone">

    <!-- Centered Apple TV Style Clean Floating Card -->
    <LinearLayout
        android:layout_width="880dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/dialog_settings_bg"
        android:clickable="true"
        android:focusable="false"
        android:orientation="vertical"
        android:paddingStart="32dp"
        android:paddingEnd="32dp"
        android:paddingTop="22dp"
        android:paddingBottom="24dp">

        <!-- Dialog Header -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:letterSpacing="-0.02"
                        android:text="การตั้งค่าโฮม (Settings)"
                        android:textColor="#FFFFFFFF"
                        android:textSize="21sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:background="#2E38BDF8"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:paddingStart="7dp"
                        android:paddingTop="2dp"
                        android:paddingEnd="7dp"
                        android:paddingBottom="2dp"
                        android:text="VIBEHACK"
                        android:textColor="#38BDF8"
                        android:textSize="10sp" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:fontFamily="@font/outfit"
                    android:fontVariationSettings="'wght' 400"
                    android:text="ปรับแต่งธีมภาพ แอนิเมชัน และทางลัดระบบทีวี"
                    android:textColor="#99FFFFFF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Close Button (Pill style) -->
            <TextView
                android:id="@+id/btnSettingsClose"
                style="@style/TopButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:gravity="center"
                android:text="✕ ปิด"
                android:textColor="@drawable/pill_text"
                android:textSize="13sp"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/btnAudioOnly"
                android:nextFocusLeft="@+id/btnWallNight"
                android:fontFamily="@font/outfit"
                android:fontVariationSettings="'wght' 600" />
        </RelativeLayout>

        <!-- 2 Columns Body Layout -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- LEFT COLUMN: Wallpaper & Dock -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginEnd="8dp"
                android:orientation="vertical">

                <!-- Card 1: Wallpaper Theme -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="ภาพพื้นหลัง (Wallpaper Theme)"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnWallAuto"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnWallAuto"
                            android:nextFocusLeft="@+id/btnWallAuto"
                            android:nextFocusRight="@+id/btnWallDay"
                            android:nextFocusDown="@+id/btnPeekUltra"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="อัตโนมัติ"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnWallDay"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnWallDay"
                            android:nextFocusLeft="@+id/btnWallAuto"
                            android:nextFocusRight="@+id/btnWallNight"
                            android:nextFocusDown="@+id/btnPeekBalanced"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="กลางวัน"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnWallNight"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnSettingsClose"
                            android:nextFocusLeft="@+id/btnWallDay"
                            android:nextFocusRight="@+id/btnAudioOnly"
                            android:nextFocusDown="@+id/btnPeekNone"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="กลางคืน"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>

                <!-- Card 2: Dock Peeking -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="มุมมอง Dock แอพ (Dock Peeking)"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnPeekUltra"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnWallAuto"
                            android:nextFocusLeft="@+id/btnPeekUltra"
                            android:nextFocusRight="@+id/btnPeekBalanced"
                            android:nextFocusDown="@+id/btnPeekUltra"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="เต็มจอ"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnPeekBalanced"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnWallDay"
                            android:nextFocusLeft="@+id/btnPeekUltra"
                            android:nextFocusRight="@+id/btnPeekNone"
                            android:nextFocusDown="@+id/btnPeekBalanced"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="พอดี"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnPeekNone"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnWallNight"
                            android:nextFocusLeft="@+id/btnPeekBalanced"
                            android:nextFocusRight="@+id/btnSysWifi"
                            android:nextFocusDown="@+id/btnPeekNone"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="ปิด"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <!-- RIGHT COLUMN: Audio-Only & TV System -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <!-- Card 3: Screen Off / Audio Only -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp"
                    android:layout_marginBottom="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="โหมดปิดจอภาพ (Audio Only)"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <TextView
                        android:id="@+id/btnAudioOnly"
                        android:layout_width="match_parent"
                        android:layout_height="44dp"
                        android:layout_marginTop="8dp"
                        android:background="@drawable/setting_option_bg"
                        android:clickable="true"
                        android:focusable="true"
                        android:focusableInTouchMode="true"
                        android:nextFocusUp="@+id/btnSettingsClose"
                        android:nextFocusLeft="@+id/btnWallNight"
                        android:nextFocusRight="@+id/btnAudioOnly"
                        android:nextFocusDown="@+id/btnSysWifi"
                        android:gravity="center"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 500"
                        android:text="ดับหน้าจอ (เล่นเพลงต่อได้)"
                        android:textColor="@drawable/setting_option_text"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- Card 4: TV System Shortcuts -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/setting_card_bg"
                    android:orientation="vertical"
                    android:paddingStart="14dp"
                    android:paddingEnd="14dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="14dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/outfit"
                        android:fontVariationSettings="'wght' 600"
                        android:text="ทางลัดระบบ (TV System)"
                        android:textColor="#FFFFFFFF"
                        android:textSize="15sp" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/btnSysWifi"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnAudioOnly"
                            android:nextFocusLeft="@+id/btnPeekNone"
                            android:nextFocusRight="@+id/btnSysApps"
                            android:nextFocusDown="@+id/btnSysWifi"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="Wi-Fi"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnSysApps"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnAudioOnly"
                            android:nextFocusLeft="@+id/btnSysWifi"
                            android:nextFocusRight="@+id/btnSysSettings"
                            android:nextFocusDown="@+id/btnSysApps"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="แอพทั้งหมด"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />

                        <TextView
                            android:id="@+id/btnSysSettings"
                            android:layout_width="0dp"
                            android:layout_height="44dp"
                            android:layout_weight="1"
                            android:layout_marginStart="4dp"
                            android:background="@drawable/setting_option_bg"
                            android:clickable="true"
                            android:focusable="true"
                            android:focusableInTouchMode="true"
                            android:nextFocusUp="@+id/btnAudioOnly"
                            android:nextFocusLeft="@+id/btnSysApps"
                            android:nextFocusRight="@+id/btnSysSettings"
                            android:nextFocusDown="@+id/btnSysSettings"
                            android:gravity="center"
                            android:fontFamily="@font/outfit"
                            android:fontVariationSettings="'wght' 500"
                            android:text="ตั้งค่าทีวี"
                            android:textColor="@drawable/setting_option_text"
                            android:textSize="13sp" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
